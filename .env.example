# Copy to .env and fill in. NEVER commit the real .env.

# --- Provider model (cloud side): Google Gemini / Gemma (FREE tier) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Default is the free Gemma model. Why not gemini-*-flash: the flash free-tier
# daily quota is small (~20 req/day) and easy to exhaust during testing; Gemma
# has a SEPARATE free quota bucket, is good at Ukrainian, and is fast enough.
# gemini-2.5-flash was retired ("no longer available to new users").
# Other free option: gemma-4-31b-it (slightly better quality, slower).
GEMINI_MODEL=gemma-4-26b-a4b-it
# Honest-cost note: if you benchmark cost on a free model, record that in REPORT.md.

# --- Local model side: Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Run config ---
# Sampling params are set per-run by the eval harness; these are defaults only.
DEFAULT_TEMPERATURE=0.0
DEFAULT_TOP_P=1.0
REQUEST_TIMEOUT_SECONDS=60

# --- Provider cost (optional) ---
# Set these to your model's real token price (USD per 1K tokens) and REPORT.md
# will show a real cost-per-1000-docs instead of null. Leave unset to keep cost
# as null (never fabricated). gemini-3.5-flash standard rate (2026-10):
#   input $1.50/1M -> 0.0015 ;  output $9.00/1M -> 0.009
# GEMINI_INPUT_PRICE_PER_1K=0.0015
# GEMINI_OUTPUT_PRICE_PER_1K=0.009

# Pacing between provider calls (free-tier RPM guard). 0 = no pacing (billing on).
# GEMINI_MIN_SECONDS_BETWEEN_CALLS=0
