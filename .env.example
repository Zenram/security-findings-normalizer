# Copy to .env and fill in. NEVER commit the real .env.

# --- Provider model (cloud side): Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
# Default is the production model used in REPORT.md: gemini-3.5-flash. It needs
# billing enabled (the free tier's ~5 req/min cap is too low for a full run);
# full-run cost is a fraction of a US cent (~$8 per 1000 docs).
# gemini-2.5-flash was retired ("no longer available to new users").
# Free alternative for local testing: set GEMINI_MODEL=gemma-4-26b-a4b-it — it
# has a SEPARATE free quota bucket, needs no billing, and is fast enough. If you
# benchmark cost on a free model, record that in REPORT.md.
GEMINI_MODEL=gemini-3.5-flash

# --- Local model side: Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# qwen2.5:7b also works. qwen3:8b is a reasoning model — the adapter sends
# think=false so it returns the JSON answer fast (~6-9s/doc vs ~116s with
# thinking on). No key needed; requires `ollama serve` + the model pulled.

# --- Run config ---
# Sampling params are set per-run by the eval harness; these are defaults only.
DEFAULT_TEMPERATURE=0.0
DEFAULT_TOP_P=1.0
REQUEST_TIMEOUT_SECONDS=60

# --- Provider cost (optional) ---
# Set these to your model's real token price (USD per 1K tokens) and REPORT.md
# will show a real cost-per-1000-docs instead of null. Leave unset to keep cost
# as null (never fabricated). gemini-3.5-flash standard rate (2026-10):
#   input $1.50/1M -> 0.0015 ;  output $9.00/1M -> 0.009
# GEMINI_INPUT_PRICE_PER_1K=0.0015
# GEMINI_OUTPUT_PRICE_PER_1K=0.009

# Pacing between provider calls (free-tier RPM guard). 0 = no pacing (billing on).
# GEMINI_MIN_SECONDS_BETWEEN_CALLS=0
