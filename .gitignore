# === Secrets / env ===
.env
.env.*
!.env.example

# === Input dataset (never commit raw inputs) ===
data/raw/
data/real/
# Keep the golden set (labeled ground truth) and data docs tracked:
!data/golden/
!data/README.md

# === RAG corpus (Part 2) ===
# Rule: commit what CANNOT be re-fetched; ignore what the script re-downloads.
# Ignore everything directly under data/corpus/ ...
data/corpus/*
# ...but keep the dir and the two committed files reachable:
!data/corpus/cve_list.txt
!data/corpus/manifest.json
!data/corpus/standard/
# Inside standard/, ignore the downloaded NIST PDFs but keep our 2 own files:
data/corpus/standard/*
!data/corpus/standard/HIPAA.md
!data/corpus/standard/SOC2_Guide_on_AWS.md
# best_practice/ and cve/ are fully re-created by scripts/fetch_corpus.py from
# cve_list.txt + URLs, so they stay ignored (not re-listed = covered by
# data/corpus/* above).

# === Run outputs ===
# Course requires model outputs in the repo, so commit the scored results and
# raw per-doc outputs, but keep transient run logs out.
results/*.log
results/**/*.log
!results/.gitkeep
!results/metrics.json
!results/REPORT_DATA.json
!results/corpus_summary.json
!results/raw/
!results/raw/*.json
!results/corpus/
!results/corpus/*.json

# === Databases / local stores ===
*.db
*.sqlite
*.sqlite3
chroma/
*.faiss
*.index

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# === OS / editor ===
.DS_Store
.idea/
.vscode/
*.swp

# === Logs ===
logs/
*.log
