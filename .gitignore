# === Secrets / env ===
.env
.env.*
!.env.example

# === Input dataset (never commit raw inputs) ===
data/raw/
data/real/
# Keep the golden set (labeled ground truth) and data docs tracked:
!data/golden/
!data/README.md

# === Run outputs ===
# Course requires model outputs in the repo, so commit the scored results and
# raw per-doc outputs, but keep transient run logs out.
results/*.log
results/**/*.log
!results/.gitkeep
!results/metrics.json
!results/REPORT_DATA.json
!results/raw/
!results/raw/*.json

# === Databases / local stores ===
*.db
*.sqlite
*.sqlite3
chroma/
*.faiss
*.index

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# === OS / editor ===
.DS_Store
.idea/
.vscode/
*.swp

# === Logs ===
logs/
*.log
