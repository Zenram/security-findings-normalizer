# === Secrets / env ===
.env
.env.*
!.env.example

# === Input dataset (never commit raw inputs) ===
data/raw/
data/real/
# Keep the golden set (labeled ground truth) and data docs tracked:
!data/golden/
!data/README.md

# === RAG corpus (Part 2) ===
# The corpus is PUBLIC data (NIST public domain, OWASP CC BY-SA, CISA public
# domain, NVD) and small (~19 MB total, largest file 5.8 MB), so we commit the
# WHOLE corpus into the repo for reproducibility — the lecturer can verify
# ingestion/retrieval against the exact source bytes without re-downloading.
# scripts/fetch_corpus.py + cve_list.txt remain as a fallback if a source URL
# ever disappears. Only truly transient/large artifacts below stay ignored.

# === RAG ingestion output (Part 2 Step 1) ===
# chunks.jsonl is large and fully regenerated by `python3 main.py --ingest`
# (from the committed/fetched corpus), so it is ignored. The small manifest +
# report ARE committed — they document the real file->doc->chunk numbers that
# the README/REPORT cite (avoids the Part-1 A6 count mismatch).
data/rag/*
!data/rag/ingest_manifest.json
!data/rag/ingest_report.json

# === Run outputs ===
# Course requires model outputs in the repo, so commit the scored results and
# raw per-doc outputs, but keep transient run logs out.
results/*.log
results/**/*.log
!results/.gitkeep
!results/metrics.json
!results/REPORT_DATA.json
!results/corpus_summary.json
!results/raw/
!results/raw/*.json
!results/corpus/
!results/corpus/*.json

# === Databases / local stores ===
*.db
*.sqlite
*.sqlite3
chroma/
*.faiss
*.index

# === RAG model/embedding caches (Part 2) ===
# fastembed downloads the embedding model into .models/
.models/
# on-disk Qdrant collection (regenerated)
data/rag/qdrant/
# embedding cache
data/rag/embeddings_cache.json

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv.*/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# === OS / editor ===
.DS_Store
.idea/
.vscode/
*.swp

# === Logs ===
logs/
*.log
